# julia
export JULIA_LOAD_PATH=":$PWD/user/strategies:$PWD"
# export JULIA_PROJECT="$PWD/Planar" # or "$PWD/PlanarOptim"
# Cross-platform CPU count: nproc on Linux, sysctl on macOS
if command -v nproc >/dev/null 2>&1; then
    export JULIA_NUM_THREADS=$(($(nproc)-2))
elif command -v sysctl >/dev/null 2>&1; then
    export JULIA_NUM_THREADS=$(($(sysctl -n hw.ncpu)-2))
else
    export JULIA_NUM_THREADS=4
fi
export JULIA_CPU_TARGET=generic

# planar
# export PLANAR_OFFLINE=true
# export PLANAR_ATOL=5e-16
# export PLANAR_QUOTE_CURRENCY=USDT
# export PLANAR_DEFAULT_ASSETS=BTC/USDT,ETH/USDT
# export PLANAR_FLOAT_TYPE=Float64

# ccxt-gateway (installed automatically from PyPI on first exchange use)
# Override the cache dir where the gateway writes its PID file / SSL cert.
# export CCXT_GATEWAY_CACHE_DIR="$HOME/.cache/ccxt-gateway"
# Pin a specific virtualenv instead of letting Planar create one from PyPI.
# export CCXT_GATEWAY_VENV="/path/to/venv"
# Suppress the gateway entirely (offline strategy runs).
# export CCXT_GATEWAY_DISABLE=true
export PLANAR_LIQUIDATION_BUFFER=0.02

# condapkg
export JULIA_CONDAPKG_ENV="$(realpath $PWD)/user/.conda"
export JULIA_CONDAPKG_OPENSSL_VERSION=3.4.0
# export JULIA_CONDAPKG_OFFINE=yes
# export JULIA_CONDAPKG_VERBOSITY=-1

# precomp
# JULIA_NOPRECOMP has been removed from all source files.
# Package entry files unconditionally include("module.jl") with
# optional include("precompile.jl") conditional on JULIA_PRECOMP.
# Only precompile during releases
export JULIA_PRECOMP=PlanarCore,Planar,PlanarOptim
# All the packages that support optional precompilation (for building releases)
export JULIA_FULL_PRECOMP=PlanarCore,Planar,PlanarOptim


# Source user/.envrc if it exists
if [ -f "user/.envrc" ]; then
    source user/.envrc
fi
